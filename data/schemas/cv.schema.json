{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dchiquiar.github.io/schemas/cv.schema.json",
  "title": "CV data",
  "description": "Estructura de la capa pública del CV de Diego Chiquiar. Un archivo por idioma (cv.en.yaml, cv.es.yaml), misma forma, contenido en su idioma. Fuente única para el sitio; el PDF combina esta capa con la privada en data/private/ (ver data/schemas/cv.private.schema.json, ADR-0002 y ADR-0004).",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "person", "experience", "education", "skills", "languages"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "lastUpdated"],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["en", "es"]
        },
        "lastUpdated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Fecha ISO (AAAA-MM-DD) de la última revisión de datos."
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "headline", "location", "seniority", "email"],
      "properties": {
        "name": { "type": "string" },
        "headline": {
          "type": "string",
          "description": "Titular factual (rol + stack), no copy de marketing: la versión final de venta se define en el proceso de contenido, no en este campo."
        },
        "location": { "type": "string" },
        "seniority": { "type": "string" },
        "summary": {
          "type": ["string", "null"],
          "description": "Bio corta. null si todavía no hay copy aprobada por Diego/talent-seeker."
        },
        "availability": {
          "type": ["string", "null"],
          "description": "Modalidad aceptada (remoto/híbrido/presencial). null = pendiente de confirmar con Diego."
        },
        "email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkedin": { "type": ["string", "null"] },
            "github": { "type": ["string", "null"] }
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "employer", "startDate", "current", "highlights", "technologies"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "employer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sector"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Nombre real del empleador. Público desde ADR-0009: identifica y es verificable. Convive con sector, no lo reemplaza."
              },
              "sector": {
                "type": ["string", "null"],
                "description": "Descripción de rubro/tamaño. Da el contexto técnico que el nombre solo no da. null = pendiente de confirmar con Diego."
              }
            }
          },
          "location": { "type": ["string", "null"] },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "description": "AAAA-MM"
          },
          "endDate": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "current": { "type": "boolean" },
          "summary": { "type": ["string", "null"] },
          "highlights": {
            "type": "array",
            "items": { "type": "string" }
          },
          "technologies": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "institution", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "institution": { "type": "string" },
          "year": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["completed", "in-progress"]
          },
          "detail": { "type": ["string", "null"] }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "intro": {
          "type": ["string", "null"],
          "description": "Párrafo corto que describe el conjunto del stack, en primera persona. Se renderiza al lado del título de la sección. null mientras no haya copy aprobada."
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "items"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "string" },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
