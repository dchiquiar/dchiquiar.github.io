{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dchiquiar.github.io/schemas/home.schema.json",
  "title": "Home copy",
  "description": "Copy propia de la home rediseñada (portada, anotación y cifras de los casos). Bilingüe por campo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "cover", "cases"],
  "definitions": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["es", "en"],
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastUpdated"],
      "properties": {
        "lastUpdated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kicker", "coordinates", "title", "lede", "statement", "note"],
      "properties": {
        "kicker": { "$ref": "#/definitions/i18n" },
        "coordinates": { "type": "string" },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lead", "emphasis"],
          "properties": {
            "lead": { "$ref": "#/definitions/i18n" },
            "emphasis": { "$ref": "#/definitions/i18n" }
          }
        },
        "lede": { "$ref": "#/definitions/i18n" },
        "statement": { "$ref": "#/definitions/i18n" },
        "note": { "$ref": "#/definitions/i18n" }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "unit", "caption", "figure", "title", "text", "technologies"],
        "properties": {
          "value": { "type": "string" },
          "unit": { "$ref": "#/definitions/i18n" },
          "caption": { "$ref": "#/definitions/i18n" },
          "figure": { "type": "string", "enum": ["banks", "signal", "states"] },
          "title": { "$ref": "#/definitions/i18n" },
          "text": { "$ref": "#/definitions/i18n" },
          "technologies": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
