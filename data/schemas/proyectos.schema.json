{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dchiquiar.github.io/schemas/proyectos.schema.json",
  "title": "Projects data",
  "description": "Lista de proyectos con código público que se muestran en el sitio, elegidos para que un reviewer técnico pueda evaluarlos en profundidad. Un solo archivo, bilingüe por campo (en/es), no hay variante cv.en/cv.es.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "projects"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastUpdated"],
      "properties": {
        "lastUpdated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "description": "Máximo 4: la vitrina prioriza profundidad sobre cantidad.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "problem", "repoUrl", "status", "technologies"],
        "properties": {
          "id": { "type": "string" },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "es"],
            "properties": {
              "en": { "type": "string" },
              "es": { "type": "string" }
            }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "es"],
            "properties": {
              "en": { "type": "string" },
              "es": { "type": "string" }
            }
          },
          "problem": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "es"],
            "properties": {
              "en": { "type": "string" },
              "es": { "type": "string" }
            }
          },
          "images": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["src", "width", "height", "alt"],
              "properties": {
                "src": {
                  "type": "string",
                  "description": "Ruta pública de la imagen (ej. /projects/urgentum-multiplayer.webp)."
                },
                "width": { "type": "integer" },
                "height": {
                  "type": "integer",
                  "description": "width y height son obligatorios: sin ellos el navegador no reserva el espacio y la página salta al cargar."
                },
                "alt": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["en", "es"],
                  "properties": {
                    "en": { "type": "string" },
                    "es": { "type": "string" }
                  }
                }
              }
            }
          },
          "repoUrl": { "type": ["string", "null"] },
          "liveUrl": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["planned", "in-progress", "done"]
          },
          "technologies": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
