---
import { ui } from "../i18n/ui.js";
import SectionHeading from "./SectionHeading.astro";
import { cleanField } from "../lib/content.js";

interface Props {
  lang: "en" | "es";
  number: string;
  person: Record<string, any>;
}
const { lang, number, person } = Astro.props;
const t = ui[lang];
const availability = cleanField(person.availability);
const linkedin = person.links?.linkedin ?? null;
const github = person.links?.github ?? null;
---

{/* F-26 (ADR-0026): "aparición simple del conjunto" — un solo
   `data-reveal` para todo el bloque (info + CTAs), sin escalonar. El
   `opacity:0` inicial no afecta que los botones sean usables: no es
   `pointer-events:none` ni `visibility:hidden`, siguen siendo
   focuseables/cliqueables desde el primer instante (ver ADR). */}
<section id="contact" class="section">
  <div class="container contact" data-reveal>
    <div class="contact__info">
      <SectionHeading number={number} title={t.sections.contact} id="contact" />
      <div class="contact__lines">
        {availability && <p>{availability}</p>}
        <p>{person.location}</p>
        <p>
          <a class="contact__email" href={`mailto:${person.email}`}>{person.email}</a>
        </p>
      </div>
    </div>
    <div class="cta-group">
      <a class="btn btn-primary" href={`mailto:${person.email}`}>
        {t.contact.emailCta}
      </a>
      {linkedin && (
        <a class="btn btn-secondary" href={linkedin}>LinkedIn</a>
      )}
      {github && (
        <a class="btn btn-secondary" href={github}>GitHub</a>
      )}
    </div>
  </div>
</section>
