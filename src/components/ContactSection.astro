---
// Contacto: nombre grande con subrayado a mano, rótulo mono y una grilla de
// enlaces (LinkedIn, GitHub, email con botón copiar, CVs).
import { ui } from "../i18n/ui.js";
import Chapter from "./Chapter.astro";
import Underline from "./Underline.astro";

interface Props {
  lang: "en" | "es";
  number: string;
  person: any;
  contact: any;
}
const { lang, number, person, contact } = Astro.props;
const t = ui[lang];
const s = t.sections.contact;
const email = contact?.email ?? person.email;
const links = contact?.links ?? person.links ?? {};
const handle = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---
<Chapter id="contact" number={number} kicker={s.kicker} title="" emphasis="">
  <Fragment slot="title">
    <span class="contact__name"><span class="underlined">{person.name}<Underline /></span></span>
  </Fragment>

  <p class="kicker contact__tags">{person.headline} · {person.location}</p>
  {contact?.description && <p class="chapter__intro" data-reveal>{contact.description}</p>}

  <ul class="contact-grid" data-reveal>
    {links.linkedin && (
      <li>
        <a class="contact-card" href={links.linkedin} rel="noopener">
          <span class="kicker">{t.contact.linkedin} <span aria-hidden="true">↗</span></span>
          <span class="contact-card__value">{handle(links.linkedin).replace("linkedin.com/", "")}</span>
        </a>
      </li>
    )}
    {links.github && (
      <li>
        <a class="contact-card" href={links.github} rel="noopener">
          <span class="kicker">{t.contact.github} <span aria-hidden="true">↗</span></span>
          <span class="contact-card__value">{handle(links.github).replace("github.com/", "")}</span>
        </a>
      </li>
    )}
    <li class="contact-card contact-card--email">
      <a href={`mailto:${email}`}>
        <span class="kicker">{t.contact.email} <span aria-hidden="true">↗</span></span>
        <span class="contact-card__value">{email}</span>
      </a>
      <button type="button" class="copy-btn" data-copy={email} data-done={t.contact.copied}>{t.contact.copy}</button>
    </li>
    <li class="contact-card contact-card--email">
      <span class="kicker">CV · PDF <span aria-hidden="true">↓</span></span>
      <span class="contact-card__value contact-card__cvs">
        <a class="link" href="/cv-en.pdf" download>English</a>
        <a class="link" href="/cv-es.pdf" download>Español</a>
      </span>
    </li>
  </ul>
</Chapter>
<script is:inline>
  document.querySelectorAll("[data-copy]").forEach(function (btn) {
    var label = btn.textContent;
    btn.addEventListener("click", function () {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(btn.getAttribute("data-copy")).then(function () {
        btn.textContent = btn.getAttribute("data-done");
        btn.classList.add("is-done");
        setTimeout(function () { btn.textContent = label; btn.classList.remove("is-done"); }, 1800);
      });
    });
  });
</script>
