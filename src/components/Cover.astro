---
// Portada: rótulos mono, título grande con subrayado a mano, bajada con
// palabras resaltadas, anotación al margen, retrato (fig. 1), índice y el
// dibujo de Montevideo (fig. 2) con la franja "Ahora".
import { ui } from "../i18n/ui.js";
import { richText } from "../lib/markup.js";
import Underline from "./Underline.astro";
import CitySketch from "./CitySketch.astro";
import Prefs from "./Prefs.astro";

interface Props {
  lang: "en" | "es";
  person: any;
  previous: any;
  home: any;
  now: any;
  toc: { id: string; number: string }[];
}
const { lang, person, previous, home, now, toc } = Astro.props;
const t = ui[lang];
const c = home.cover;
const cvHref = lang === "es" ? "/cv-es.pdf" : "/cv-en.pdf";
const noteLines = c.note[lang].split("\n");
---
<section class="cover" id="top" aria-labelledby="cover-title">
  <div class="cover__meta">
    <p class="kicker">{person.name} · {c.kicker[lang]}</p>
    <p class="kicker cover__coords">{c.coordinates}</p>
  </div>

  <h1 class="display display--cover" id="cover-title">
    <span class="cover__line">{c.title.lead[lang]}</span>
    <span class="cover__line"><span class="underlined">{c.title.emphasis[lang]}<Underline /></span><span class="dot">.</span></span>
  </h1>

  <div class="cover__grid">
    <div class="cover__text">
      <p class="lede" set:html={richText(c.lede[lang])} />

      {previous && (
        <p class="previously">
          <span class="kicker">{t.previously}</span>{" "}
          {previous.role}{previous.employer.sector && <span class="muted">, {previous.employer.sector.charAt(0).toLowerCase() + previous.employer.sector.slice(1)}</span>}.
        </p>
      )}

      <div class="annotated">
        <p class="statement" set:html={richText(c.statement[lang])} />
        <p class="margin-note">
          <svg class="margin-note__arrow" viewBox="0 0 120 40" aria-hidden="true">
            <path pathLength="1" d="M118 22 C 90 32, 50 30, 10 16" />
            <path pathLength="1" d="M22 8 L 9 16 L 22 25" />
          </svg>
          {noteLines.map((l) => <span>{l}</span>)}
        </p>
      </div>

      <div class="cover__ctas">
        <a class="btn btn--ink" href="#projects">{t.seeWork} <span aria-hidden="true">↓</span></a>
        <a class="btn btn--line" href={cvHref} download>{t.downloadCv} <span aria-hidden="true">↓</span></a>
      </div>

      {person.availability && (
        <p class="availability"><span class="pulse" aria-hidden="true"></span>{person.availability}</p>
      )}

      <Prefs lang={lang} variant="cover" />
    </div>

    <aside class="cover__side">
      <figure class="portrait">
        <div class="portrait__frame">
          <img
            src="/images/diego-laughing.webp"
            width="400"
            height="400"
            alt={lang === "es" ? "Diego Chiquiar sonriendo, con un buzo tejido claro sobre fondo oscuro" : "Diego Chiquiar smiling, wearing a light cable-knit sweater against a dark background"}
            fetchpriority="high"
          />
          <span class="tick tick--tl" aria-hidden="true"></span>
          <span class="tick tick--tr" aria-hidden="true"></span>
          <span class="tick tick--bl" aria-hidden="true"></span>
          <span class="tick tick--br" aria-hidden="true"></span>
        </div>
        <figcaption class="figcap">{t.figCover}</figcaption>
      </figure>

      <nav class="toc" aria-label={t.contents}>
        <p class="kicker">{t.contents}</p>
        <ol>
          {toc.map((s) => (
            <li><a href={`#${s.id}`}><span class="toc__n">{s.number}</span><span>{t.nav[s.id]}</span></a></li>
          ))}
        </ol>
      </nav>
    </aside>
  </div>

  <figure class="city" data-reveal>
    <CitySketch />
    <figcaption class="figcap figcap--right">{t.figCity}</figcaption>
  </figure>

  <div class="now-strip">
    <span class="now-strip__label"><span class="pulse" aria-hidden="true"></span>{t.now}</span>
    <ul>
      {now.items.map((i: any) => (
        <li><span class="now-strip__item">{i.label}</span> <span class="muted">· {i.status}</span></li>
      ))}
    </ul>
  </div>
</section>
