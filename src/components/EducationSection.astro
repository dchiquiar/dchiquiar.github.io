---
import { ui } from "../i18n/ui.js";
import Chapter from "./Chapter.astro";

interface Props {
  lang: "en" | "es";
  number: string;
  education: any[];
}
const { lang, number, education } = Astro.props;
const t = ui[lang];
const s = t.sections.education;
---
<Chapter id="education" number={number} kicker={s.kicker} title={s.title} emphasis={s.emphasis}>
  <ol class="edu" data-reveal>
    {education.map((e) => (
      <li class={`edu__item ${e.status === "in-progress" ? "is-live" : ""}`}>
        <p class="edu__year">
          {e.status === "in-progress" ? (
            <span class="badge"><span class="pulse" aria-hidden="true"></span>{t.education.inProgress}</span>
          ) : (
            <span>{e.year ?? t.education.completed}</span>
          )}
        </p>
        <div>
          <h3 class="edu__title">{e.title}</h3>
          <p class="kicker">{e.institution}</p>
          {e.detail && <p class="edu__detail">{e.detail}</p>}
        </div>
      </li>
    ))}
  </ol>
</Chapter>
