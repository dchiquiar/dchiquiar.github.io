---
// Experiencia: línea de tiempo a escala (fig. 3) y filas que se expanden.
import { ui } from "../i18n/ui.js";
import { splitParagraphs } from "../lib/content.js";
import { formatDateRange } from "../lib/format.js";
import Chapter from "./Chapter.astro";

interface Props {
  lang: "en" | "es";
  number: string;
  experience: any[];
  hiddenEmployers?: string[];
}
const { lang, number, experience, hiddenEmployers = [] } = Astro.props;
// Nombre público del empleador: el rubro cuando Diego pidió no nombrarlo.
const employerLabel = (e: any) =>
  hiddenEmployers.includes(e.id) && e.employer.sector ? e.employer.sector : e.employer.name;
const t = ui[lang];
const s = t.sections.experience;

const toNum = (ym: string) => {
  const [y, m] = ym.split("-").map(Number);
  return y + (m - 1) / 12;
};
const today = new Date();
const nowNum = today.getFullYear() + today.getMonth() / 12;
const items = experience.map((e) => ({
  ...e,
  from: toNum(e.startDate),
  to: e.endDate ? toNum(e.endDate) : nowNum,
}));
const min = Math.floor(Math.min(...items.map((i) => i.from)));
const max = Math.max(nowNum, ...items.map((i) => i.to));
const pct = (v: number) => ((v - min) / (max - min)) * 100;
const ticks: number[] = [];
for (let y = min; y <= Math.floor(max); y += 1) ticks.push(y);
const sorted = [...items].sort((a, b) => a.from - b.from);
---
<Chapter id="experience" number={number} kicker={s.kicker} title={s.title} emphasis={s.emphasis}>
  <figure class="timeline" data-reveal>
    <div class="timeline__track">
      {sorted.map((e, i) => (
        <div
          class={`timeline__bar ${i === sorted.length - 1 ? "is-latest" : ""}`}
          style={`left:${pct(e.from)}%;width:${Math.max(pct(e.to) - pct(e.from), 1.2)}%;--row:${i % 2}`}
        >
          <span class="timeline__label">{employerLabel(e).split(" — ")[0]}</span>
        </div>
      ))}
      <div class="timeline__axis" aria-hidden="true">
        {ticks.map((y) => (
          <span class={`timeline__tick ${y % 2 === 1 ? "is-minor" : ""}`} style={`left:${pct(y)}%`}>
            <span>{y}</span>
          </span>
        ))}
        <span class="timeline__now" style="left:100%"><span>{t.experience.now}</span></span>
      </div>
    </div>
    <figcaption class="figcap">{t.experience.figTimeline.replace("{from}", String(min))}</figcaption>
  </figure>

  <ol class="rows rows--xp" data-reveal>
    {experience.map((e) => {
      const paras = splitParagraphs(e.summary);
      return (
        <li class="row">
          <details class="row__details">
            <summary class="row__summary row__summary--xp">
              <span class="row__title">{employerLabel(e)}</span>
              <span class="row__role">{e.role}</span>
              <span class="row__years">{formatDateRange(e, lang)}</span>
              <span class="row__arrow" aria-hidden="true">→</span>
            </summary>
            <div class="row__more">
              {e.employer.sector && !hiddenEmployers.includes(e.id) && <p class="kicker">{e.employer.sector}{e.location && ` · ${e.location}`}</p>}
              {hiddenEmployers.includes(e.id) && e.location && <p class="kicker">{e.location}</p>}
              {paras.map((p) => <p>{p}</p>)}
              {e.highlights?.length > 0 && (
                <ul class="bullets">
                  {e.highlights.map((h: string) => <li>{h}</li>)}
                </ul>
              )}
              {e.technologies?.length > 0 && (
                <ul class="tags tags--small">
                  {e.technologies.map((tech: string) => <li>{tech}</li>)}
                </ul>
              )}
            </div>
          </details>
        </li>
      );
    })}
  </ol>
</Chapter>
