---
import { ui } from "../i18n/ui.js";
import SectionHeading from "./SectionHeading.astro";
import { cleanField, cleanList, splitParagraphs } from "../lib/content.js";
import { formatDateRange } from "../lib/format.js";

interface Props {
  lang: "en" | "es";
  number: string;
  experience: Array<Record<string, any>>;
}
const { lang, number, experience } = Astro.props;
const t = ui[lang];
const cvHref = lang === "es" ? "/cv-es.pdf" : "/cv-en.pdf";
---

<section id="experience" class="section">
  <div class="container">
    <SectionHeading number={number} title={t.sections.experience} id="experience" />

    <p>
      <a class="btn btn-primary" href={cvHref} download>{t.experience.downloadCv}</a>
    </p>

    {experience.map((job) => {
      const employerName = cleanField(job.employer?.name);
      const sector = cleanField(job.employer?.sector);
      // `job.summary` es una línea corta con comillas dobles en el YAML,
      // no un bloque plegado (`>-`) como `person.summary`/`project.description`:
      // por contrato no trae varios párrafos, así que no necesita
      // `splitParagraphs` (revisado a propósito, no es un olvido).
      const summary = cleanField(job.summary);
      const highlights = cleanList(job.highlights);
      const technologies = job.technologies ?? [];
      // `projects` es nuevo y opcional (ADR-0010): sólo algunos empleos lo
      // traen. Cada proyecto pasa por el mismo filtro que cualquier otro
      // campo del YAML; si falta nombre o descripción, ese proyecto no se
      // muestra (mismo criterio defensivo que el resto del sitio).
      const projects = (job.projects ?? [])
        .map((p) => ({
          name: cleanField(p?.name),
          description: cleanField(p?.description),
          technologies: cleanList(p?.technologies),
        }))
        .filter((p) => p.name && p.description);
      return (
        <div class="job">
          <div class="job__header">
            <h3 class="job__role">{job.role}</h3>
            <span class="job__dates">{formatDateRange(job, lang)}</span>
          </div>
          {employerName && <p class="job__employer">{employerName}</p>}
          {(sector || job.location) && (
            <p class="job__meta">
              {[sector, job.location].filter(Boolean).join(" · ")}
            </p>
          )}
          {summary && <p class="job__summary">{summary}</p>}
          {projects.length > 0 && (
            <div class="job__projects">
              {projects.map((project) => (
                <div class="job__project">
                  <h4 class="job__project-name">{project.name}</h4>
                  {/* `description` puede traer varios párrafos separados
                      por línea en blanco (TAS, hoy el único caso) — mismo
                      contrato de YAML plegado (`>-`) que person.summary y
                      la description de ProjectCard. Un solo `<p>` colapsaba
                      el salto en un bloque único. */}
                  {splitParagraphs(project.description).map((paragraph) => (
                    <p class="job__project-description">{paragraph}</p>
                  ))}
                  {project.technologies.length > 0 && (
                    <ul class="tag-list">
                      {project.technologies.map((tech) => (
                        <li class="tag">{tech}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          )}
          {highlights.length > 0 && (
            <ul class="job__highlights">
              {highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
          {technologies.length > 0 && (
            <>
              {/* Dos niveles de tags conviven cuando hay proyectos: éstos
                  son el stack agregado de TODO el puesto, los de arriba
                  son de cada proyecto puntual. El eyebrow lo deja explícito
                  sólo cuando hace falta desambiguar; sin proyectos, esta
                  lista es la única señal de stack y no necesita etiqueta. */}
              {projects.length > 0 && (
                <span class="eyebrow">{t.experience.roleStackLabel}</span>
              )}
              <ul class="tag-list">
                {technologies.map((tech) => (
                  <li class="tag">{tech}</li>
                ))}
              </ul>
            </>
          )}
        </div>
      );
    })}
  </div>
</section>
