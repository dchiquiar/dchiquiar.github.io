---
// F-18 (ADR-0019 §2): hero humano. Orden conceptual: foto · saludo ·
// nombre · rol · "desde {ubicación}" · intro en primera persona (hasta 2
// párrafos) · dato destacado / disponibilidad / links (los tres opcionales,
// se omiten sin dejar hueco si no hay valor confirmado) · CTAs.
//
// person.tagline (nuevo en el YAML) NO se renderiza acá a propósito
// (decisión de Diego en el brief de F-18, "evitar sobrecarga"): el campo
// queda disponible en data/cv.*.yaml para cuando se decida usarlo, pero
// este componente no lo lee. Sin edad en ningún punto del hero (ADR-0019).
import { ui } from "../i18n/ui.js";
import { cleanField, splitParagraphs, loadNow } from "../lib/content.js";

interface Props {
  lang: "en" | "es";
  person: Record<string, any>;
}
const { lang, person } = Astro.props;
const t = ui[lang];
const cvHref = lang === "es" ? "/cv-es.pdf" : "/cv-en.pdf";

// Todos opcionales (cv.en.yaml todavía no trae greeting/featuredFact — F-18
// enmienda cv.es.yaml primero): sin valor confirmado, cada uno se omite sin
// dejar hueco ni marcador, mismo criterio que ya usaba availability/intro
// antes de esta tarea.
const greeting = cleanField(person.greeting);
const availability = cleanField(person.availability);
const featuredFact = cleanField(person.featuredFact);
const linkedin = person.links?.linkedin ?? null;
const github = person.links?.github ?? null;

// person.intro (ADR-0015) puede traer hasta 2 párrafos separados por línea
// en blanco (mismo contrato YAML plegado que person.summary/project.
// description, ver content.js) — un solo <p> los uniría en un bloque
// corrido. splitParagraphs ya resuelve esto en el resto del sitio.
const introParagraphs = splitParagraphs(cleanField(person.intro) ?? "");

// F-20: terminal decorativa "$ cat now.txt" — un solo archivo
// (data/now.yaml) para los dos idiomas, ya en inglés en el propio dato
// (se presenta como código, no como copy traducible, decisión de Diego).
// Sin cleanField/cleanList: now.schema.json ya exige command/items no
// vacíos y validate-data.mjs corre el mismo filtro anti-placeholder sobre
// este archivo que sobre cv.*.yaml (ver scripts/validate-data.mjs).
const now = loadNow();

// Alt del retrato: no es contenido del CV (no sale de data/cv.*.yaml, es
// un hecho fijo de la propia foto), así que se escribe acá directo con
// el mismo criterio que ya usa HomePage.astro para el meta description —
// texto corto y bilingüe atado al markup, no a ui.js (que es sólo chrome
// de interfaz) ni al YAML.
const portraitAlt =
  lang === "es"
    ? "Retrato de Diego Chiquiar, con buzo oscuro"
    : "Portrait of Diego Chiquiar, wearing a dark hoodie";

// F-16: entrada letra por letra, cayendo desde arriba, con cursor de
// máquina de escribir (reemplaza F-14, que animaba palabra por palabra —
// ver esa entrada en el log para el porqué de la curva y el perspective,
// que siguen vigentes). Se sigue partiendo `person.name` en vez de
// hardcodear "Diego"/"Chiquiar": es el mismo string en los dos idiomas
// (nombre propio, no se traduce), así que esto no duplica contenido
// ES/EN, sólo reparte el dato.
//
// `letterStep` es la posición de cada letra en el RITMO de tipeo (0.08s
// por paso, ver global.css), no su índice dentro de la palabra: crece de
// a 1 por letra y +1 extra por cada espacio entre palabras, porque Diego
// pidió que el espacio cuente como un paso pausado del ritmo sin
// animarse. El espacio en sí sigue sin tener <span> propio — nodo de
// texto SUELTO entre los `.hero__name-word`, igual que en F-14, para no
// tocar el punto de wrap entre palabras. `Array.from(word)` en vez de
// `word.split("")`: recorre por punto de código Unicode, no por unidad
// UTF-16, así que no partiría mal un carácter compuesto si el nombre
// cambiara a futuro (no aplica a "Diego Chiquiar" hoy, pero no cuesta
// nada hacerlo bien).
let letterStep = 0;
const nameWordsData = person.name
  .trim()
  .split(/\s+/)
  .map((word, wi, words) => {
    const letters = Array.from(word).map((ch) => {
      const step = letterStep;
      letterStep += 1;
      return { ch, step };
    });
    if (wi < words.length - 1) letterStep += 1; // paso del espacio, sin animar
    return { letters };
  });
---

<section id="intro" class="hero">
  <div class="container hero__layout">
    <div class="hero__content">
      {greeting && <p class="hero__greeting">{greeting}</p>}
      {/* Nombre accesible fijado por `aria-label` en el propio h1: con el
         nombre partido en <span> por letra, algunos lectores de pantalla
         (ej. VoiceOver) deletrean en vez de leer la palabra completa. El
         `<span aria-hidden="true">` interno saca todo el markup de letras
         del árbol de accesibilidad — el h1 queda con su único nombre
         accesible siendo el texto plano de `aria-label`, verificado en el
         árbol de accesibilidad (ver reporte F-16). */}
      <h1 class="hero__name" aria-label={person.name}>
        <span class="hero__name-letters" aria-hidden="true">
          {nameWordsData.map((word, wi) => (
            <>
              <span class="hero__name-word">
                {word.letters.map((l) => (
                  <span class="hero__name-letter" style={`--letter-step: ${l.step}`}>
                    {l.ch}
                  </span>
                ))}
              </span>
              {wi < nameWordsData.length - 1 && " "}
            </>
          ))}
        </span>
      </h1>
      <p class="hero__role">{person.headline}</p>
      <p class="hero__location">
        {t.hero.from} {person.location}
      </p>
      {introParagraphs.length > 0 && (
        <div class="hero__intro">
          {introParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
      {/* F-20 (A-4 P1-2): el dato destacado, la disponibilidad y los links
         eran tres filas propias con tres tratamientos de peso distintos
         (fact con filete de acento + itálica llevaba MÁS peso que
         availability, aunque PRODUCT.md exige que availability se vea y
         fact es opcional). Ahora comparten `.hero__support`, al costado
         del CTA, con un único tratamiento (mismo tamaño, misma tinta
         suave, sin filete): ninguno de los dos pesa más que el otro. En
         mobile, `.hero__fact`/`.hero__links` se siguen ocultando (ADR-0019
         §2, mismo selector de clase que ya usaba F-18) — sólo
         `.hero__availability` es obligatorio ahí. */}
      <div class="hero__action">
        <div class="cta-group">
          <a class="btn btn-primary" href={cvHref} download>
            {t.hero.downloadCv}
          </a>
          <a class="btn btn-secondary" href="#projects">
            {t.hero.viewProjects}
          </a>
        </div>
        {(featuredFact || availability || linkedin || github) && (
          <div class="hero__support">
            {featuredFact && <p class="hero__fact">{featuredFact}</p>}
            {availability && <p class="hero__availability">{availability}</p>}
            {(linkedin || github) && (
              <p class="hero__links">
                {linkedin && <a href={linkedin}>LinkedIn</a>}
                {github && <a href={github}>GitHub</a>}
              </p>
            )}
          </div>
        )}
      </div>
      {/* F-20: terminal "$ cat now.txt", después del grupo de CTAs a
         propósito — nunca antes (A-4: en mobile el CTA ya cierra a
         794,8px de 812px, sin presupuesto para meter esto arriba sin
         romper PRODUCT.md Principio 1). Texto real, sin partir en letras
         (a diferencia de .hero__name-letters): un lector de pantalla lee
         cada línea entera y de corrido, la animación de `clip-path` no
         saca nada del árbol de accesibilidad. `$`/`→` son sintaxis
         decorativa (aria-hidden) para no anunciarse como "dólar"/"flecha"
         cuatro veces; el rótulo real de la región es
         t.hero.currentlyLearningLabel. */}
      <div class="hero__terminal" role="group" aria-label={t.hero.currentlyLearningLabel}>
        <p class="hero__terminal-line hero__terminal-prompt">
          <span class="hero__terminal-sigil" aria-hidden="true">$</span>
          <span class="hero__terminal-typed">{now.command}</span>
        </p>
        <ul class="hero__terminal-list">
          {now.items.map((item, i) => (
            <li class="hero__terminal-item" style={`--line-index: ${i}`}>
              <span class="hero__terminal-arrow" aria-hidden="true">→</span>
              <span class="hero__terminal-item-text">
                {item.label} <span class="hero__terminal-status">— {item.status}</span>
              </span>
            </li>
          ))}
        </ul>
        <p class="hero__terminal-line hero__terminal-prompt hero__terminal-final">
          <span class="hero__terminal-sigil" aria-hidden="true">$</span>
          <span class="hero__terminal-cursor" aria-hidden="true"></span>
        </p>
      </div>
    </div>
    <div class="hero__media">
      <img
        src="/images/diego-portrait.webp"
        width="520"
        height="898"
        alt={portraitAlt}
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
