---
// Único componente de página: src/pages/index.astro y src/pages/es/index.astro
// sólo le pasan `lang`. El orden de las secciones sale de
// cv.meta.sectionOrder; una sección sin contenido no se renderiza ni
// aparece en el índice ni en la barra superior.
import BaseLayout from "../layouts/BaseLayout.astro";
import Cover from "./Cover.astro";
import StackSection from "./StackSection.astro";
import WorkSection from "./WorkSection.astro";
import ExperienceSection from "./ExperienceSection.astro";
import EducationSection from "./EducationSection.astro";
import AboutSection from "./AboutSection.astro";
import ContactSection from "./ContactSection.astro";
import { loadCv, loadProjects, loadHobbies, loadHome, loadNow, cleanField } from "../lib/content.js";

interface Props {
  lang: "en" | "es";
}
const { lang } = Astro.props;
const cv = loadCv(lang);
const home = loadHome();
const now = loadNow();
const hobbies = loadHobbies();
const { person } = cv;

const experienceItems = cv.experience ?? [];
const educationItems = cv.education ?? [];
const projects = loadProjects().filter((p: any) => p.status !== "planned");
const visibleHobbiesCount = (hobbies.items ?? []).filter((h: any) => (h.images ?? []).length > 0).length;
const featuredJob = experienceItems.find((e: any) => (e.projects ?? []).length > 0) ?? null;
const skills = { ...cv.skills, intro: cleanField(cv.skills?.intro ?? null) };

const DEFAULT_SECTION_ORDER = ["intro", "skills", "projects", "experience", "education", "hobbies", "contact"];
const rawOrder: string[] = cv.meta?.sectionOrder ?? DEFAULT_SECTION_ORDER;
const sectionHasContent: Record<string, boolean> = {
  intro: true,
  skills: (cv.skills?.categories?.length ?? 0) > 0,
  projects: projects.length > 0 || Boolean(featuredJob),
  experience: experienceItems.length > 0,
  education: educationItems.length > 0,
  hobbies: visibleHobbiesCount > 0,
  contact: true,
};
const orderedSections = rawOrder.filter((id) => sectionHasContent[id] === true);
const navSections = orderedSections.filter((id) => id !== "intro");
const numbers: Record<string, string> = {};
navSections.forEach((id, i) => (numbers[id] = String(i + 1).padStart(2, "0")));
const toc = navSections.map((id) => ({ id, number: numbers[id] }));

const title = `${person.name} — ${person.headline}`;
const description =
  lang === "es"
    ? `${person.name} — ${person.headline}. Con base en ${person.location}. Portfolio, CV y proyectos.`
    : `${person.name} — ${person.headline}. Based in ${person.location}. Portfolio, CV and projects.`;
const path = lang === "es" ? "/es/" : "/";
const siteUrl = "https://diegochiquiar.dev";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  jobTitle: person.headline,
  email: `mailto:${person.email}`,
  url: `${siteUrl}${path}`,
  image: `${siteUrl}/images/diego-laughing.webp`,
  address: { "@type": "PostalAddress", addressLocality: "Montevideo", addressCountry: "UY" },
  sameAs: [person.links?.linkedin, person.links?.github].filter(Boolean),
};
---

<BaseLayout lang={lang} title={title} description={description} jsonLd={jsonLd} sections={navSections}>
  <main id="main">
    {orderedSections.map((id) => {
      switch (id) {
        case "intro":
          return <Cover lang={lang} person={person} previous={experienceItems[0] ?? null} home={home} now={now} toc={toc} />;
        case "skills":
          return <StackSection lang={lang} number={numbers.skills} skills={skills} languages={cv.languages ?? []} />;
        case "projects":
          return <WorkSection lang={lang} number={numbers.projects} job={featuredJob} cases={home.cases ?? []} projects={projects} />;
        case "experience":
          return <ExperienceSection lang={lang} number={numbers.experience} experience={experienceItems} hiddenEmployers={home.hideEmployerNames ?? []} />;
        case "education":
          return <EducationSection lang={lang} number={numbers.education} education={educationItems} />;
        case "hobbies":
          return <AboutSection lang={lang} number={numbers.hobbies} hobbies={hobbies} />;
        case "contact":
          return <ContactSection lang={lang} number={numbers.contact} person={person} contact={cv.contact} />;
        default:
          return null;
      }
    })}
  </main>
</BaseLayout>
