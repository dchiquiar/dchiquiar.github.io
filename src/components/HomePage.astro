---
// Único componente de página: src/pages/index.astro y src/pages/es/index.astro
// sólo le pasan `lang`. Cero markup duplicado entre idiomas.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./Hero.astro";
import ProjectsSection from "./ProjectsSection.astro";
import ExperienceSection from "./ExperienceSection.astro";
import SkillsSection from "./SkillsSection.astro";
import AboutSection from "./AboutSection.astro";
import ContactSection from "./ContactSection.astro";
import { loadCv, cleanField } from "../lib/content.js";

interface Props {
  lang: "en" | "es";
}
const { lang } = Astro.props;
const cv = loadCv(lang);
const { person } = cv;

// person.summary puede no estar confirmado todavía (queda null o con nota
// TODO en el YAML): si no hay valor limpio, la sección "Sobre mí" no
// existe — nada de encabezado ni entrada de nav para una sección vacía.
const summary = cleanField(person.summary);
const contactNumber = summary ? "05" : "04";
const stackIntro = cleanField(cv.skills?.intro ?? null);

const title = `${person.name} — ${person.headline}`;
const description =
  lang === "es"
    ? `${person.name} — ${person.headline}. Con base en ${person.location}. Portfolio, CV y proyectos.`
    : `${person.name} — ${person.headline}. Based in ${person.location}. Portfolio, CV and projects.`;

const path = lang === "es" ? "/es/" : "/";
const siteUrl = "https://dchiquiar.github.io";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  jobTitle: person.headline,
  email: `mailto:${person.email}`,
  url: `${siteUrl}${path}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Montevideo",
    addressCountry: "UY",
  },
  ...(person.links?.linkedin || person.links?.github
    ? {
        sameAs: [person.links?.linkedin, person.links?.github].filter(Boolean),
      }
    : {}),
};
---

<BaseLayout lang={lang} title={title} description={description} jsonLd={jsonLd} showAbout={Boolean(summary)}>
  <main id="main">
    <Hero lang={lang} person={person} />
    <ProjectsSection lang={lang} />
    <ExperienceSection lang={lang} experience={cv.experience} education={cv.education} />
    <SkillsSection lang={lang} categories={cv.skills.categories} languages={cv.languages} intro={stackIntro} />
    {summary && <AboutSection lang={lang} number="04" summary={summary} />}
    <ContactSection lang={lang} number={contactNumber} person={person} />
  </main>
</BaseLayout>
