---
// Carrusel de capturas (ADR-0008 sigue vigente como base): scroll-snap de
// CSS, contenedor enfocable con nombre accesible, funciona sin JS. F-19
// (ADR-0019 §5) agrega un nivel 2 de navegación ENCIMA de esa base: flechas
// chicas superpuestas a la imagen y puntos convertidos en botones reales.
// Nacen `disabled` + `aria-hidden="true"` (invisibles/inertes) y el script
// inline de ProjectsSection.astro los activa — sin ese script, el
// carrusel sigue exactamente como antes de F-19 (scroll nativo, puntos
// decorativos). `images` sólo llega con datos cuando el proyecto los
// tiene (hoy sólo game-server); si viene vacío no se renderiza nada — ni
// marco ni hueco (mismo criterio que el resto de la tarjeta).
import { ui } from "../i18n/ui.js";
import { splitParagraphs } from "../lib/content.js";

interface ProjectImage {
  src: string;
  width: number;
  height: number;
  alt: { en: string; es: string };
}

interface Props {
  lang: "en" | "es";
  id: string;
  title: string;
  description: string;
  problem: string;
  technologies?: string[];
  images?: ProjectImage[];
  repoUrl?: string | null;
  liveUrl?: string | null;
}
const {
  lang,
  id,
  title,
  description,
  problem,
  technologies = [],
  images = [],
  repoUrl = null,
  liveUrl = null,
} = Astro.props;
const t = ui[lang];
const carouselLabel = `${title} — ${t.projects.screenshotsLabel}`;
const trackId = `carousel-track-${id}`;

function fillTemplate(tpl: string, current: number, total: number) {
  return tpl.replace("{current}", String(current)).replace("{total}", String(total));
}

// `description` puede traer dos párrafos separados por línea en blanco
// (game-server, hoy es el único caso). Un solo `<p>` colapsaba el salto:
// se veía como un único bloque de 600 caracteres. Mismo criterio que
// AboutSection: primer párrafo con el peso destacado, siguientes en peso
// normal, pero acá el primero SIEMPRE se destaca (haya uno o más), a
// diferencia del lead de "Sobre mí" — es el comportamiento actual con un
// único párrafo y no hay que cambiarlo.
const descriptionParagraphs = splitParagraphs(description);
---

<article class="project-card">
  {images.length > 0 && (
    <div class="carousel-frame">
      <div
        class="carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label={carouselLabel}
        tabindex="0"
        data-carousel
      >
        <ul class="carousel__track" id={trackId}>
          {images.map((img) => (
            <li class="carousel__item" data-carousel-item>
              {/* F-24 (P1): sin caso especial para la primera captura. Antes
                  llevaba fetchpriority="high" asumiendo que era el LCP, pero
                  medido queda muy por debajo del pliegue (2.976px a 375×812,
                  2.458px a 1440×900) — competía por ancho de banda con el
                  retrato del hero (el elemento real de LCP en mobile, que sí
                  lleva fetchpriority="high") y con las fuentes, sin ninguna
                  ganancia real. Todas las capturas van lazy. */}
              <img
                src={img.src}
                width={img.width}
                height={img.height}
                alt={img.alt[lang]}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </div>
      {images.length > 1 && (
        <>
          <button
            type="button"
            class="carousel__nav carousel__nav--prev"
            data-carousel-prev
            aria-label={t.projects.prevScreenshot}
            aria-controls={trackId}
            disabled
            aria-hidden="true"
          >
            <span aria-hidden="true">‹</span>
          </button>
          <button
            type="button"
            class="carousel__nav carousel__nav--next"
            data-carousel-next
            aria-label={t.projects.nextScreenshot}
            aria-controls={trackId}
            disabled
            aria-hidden="true"
          >
            <span aria-hidden="true">›</span>
          </button>
          <div class="carousel__dots">
            {images.map((img, i) => (
              <button
                type="button"
                class="carousel__dot"
                data-carousel-dot
                aria-label={fillTemplate(t.projects.screenshotLabelTemplate, i + 1, images.length)}
                aria-controls={trackId}
                disabled
                aria-hidden="true"
              ></button>
            ))}
          </div>
        </>
      )}
    </div>
  )}
  <div class="project-card__body">
    <h3>{title}</h3>
    {descriptionParagraphs.map((paragraph, i) => (
      <p class={i === 0 ? "project-card__description" : "project-card__description--secondary"}>
        {paragraph}
      </p>
    ))}
    <p class="project-card__problem">
      <span class="project-card__problem-label">{t.projects.problemLabel}</span>
      {problem}
    </p>
    {technologies.length > 0 && (
      <ul class="tag-list">
        {technologies.map((tech) => (
          <li class="tag">{tech}</li>
        ))}
      </ul>
    )}
    <div class="project-card__links">
      {repoUrl ? (
        <a class="project-card__link" href={repoUrl}>{t.projects.viewCode}</a>
      ) : (
        <span class="project-card__no-repo">{t.projects.noRepoNote}</span>
      )}
      {liveUrl && <a class="project-card__link" href={liveUrl}>{t.projects.viewLive}</a>}
    </div>
  </div>
</article>
