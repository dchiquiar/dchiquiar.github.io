---
// Fuente: data/proyectos.yaml (orden y selección cerrados en F1-C, no
// reordenar). Los proyectos con status "planned" no se muestran: un
// proyecto anunciado y no construido confirma la objeción de que no se
// terminan las cosas (vault/05-recruiting/recomendaciones.md §2). Cuando
// el MCP deje de estar "planned" reaparece solo, en su lugar en el YAML.
//
// Los proyectos visibles no prueban lo mismo entre sí
// (vault/06-contenido/fichas-proyectos-es.md §5): el primero se renderiza
// con variant="featured" para que se perciba la jerarquía, no una grilla
// de clones.
import { ui } from "../i18n/ui.js";
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import { loadProjects } from "../lib/content.js";

interface Props {
  lang: "en" | "es";
}
const { lang } = Astro.props;
const t = ui[lang];

const cards = loadProjects()
  .filter((p) => p.status !== "planned")
  .map((p) => ({
    title: p.title[lang],
    description: p.description[lang],
    problem: p.problem[lang],
    technologies: p.technologies ?? [],
    images: p.images ?? [],
    repoUrl: p.repoUrl ?? null,
    liveUrl: p.liveUrl ?? null,
  }));
---

<section id="projects" class="section">
  <div class="container">
    <SectionHeading number="01" title={t.sections.projects} id="projects" />
    <div class="project-grid">
      {cards.map((card, index) => (
        <ProjectCard lang={lang} variant={index === 0 ? "featured" : "standard"} {...card} />
      ))}
    </div>
  </div>
</section>
