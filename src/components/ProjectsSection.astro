---
// data/proyectos.yaml todavía está vacío (F1-C sin cerrar, ver backlog).
// Mientras tanto se muestran 3 fichas de relleno OBVIAMENTE provisorias,
// por instrucción explícita del brief de F4 — no se inventa contenido real
// de proyectos. Campos exactos que necesita el schema real están en el
// reporte de esta tarea.
import { ui } from "../i18n/ui.js";
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import { loadProjects } from "../lib/content.js";

interface Props {
  lang: "en" | "es";
}
const { lang } = Astro.props;
const t = ui[lang];

const realProjects = loadProjects();

const PLACEHOLDER_PROJECTS = {
  en: [
    {
      title: "[Placeholder] Agent-assisted portfolio pipeline",
      tagline: "Draft — one-line summary pending.",
      problem:
        "Draft — this paragraph will describe the interesting problem this project solves, once talent-seeker closes the project write-ups (backlog F1-C).",
      technologies: ["Astro", "Node.js", "Claude Code"],
      repoUrl: "https://github.com/dchiquiar/dchiquiar.github.io",
      liveUrl: null,
    },
    {
      title: "[Placeholder] Multiplayer game server",
      tagline: "Draft — one-line summary pending.",
      problem:
        "Draft — server-authoritative concurrency problem write-up pending confirmation of what can be shown publicly.",
      technologies: [".NET", "TCP", "SQL Server"],
      repoUrl: null,
      liveUrl: null,
    },
    {
      title: "[Placeholder] Third project — not yet selected",
      tagline: "Draft — one-line summary pending.",
      problem: "Draft — pending F1-C project selection.",
      technologies: ["TBD"],
      repoUrl: null,
      liveUrl: null,
    },
  ],
  es: [
    {
      title: "[Marcador] Pipeline de portfolio asistido por agentes",
      tagline: "Borrador — falta la línea resumen.",
      problem:
        "Borrador — este párrafo va a describir el problema interesante que resuelve este proyecto, cuando talent-seeker cierre las fichas (backlog F1-C).",
      technologies: ["Astro", "Node.js", "Claude Code"],
      repoUrl: "https://github.com/dchiquiar/dchiquiar.github.io",
      liveUrl: null,
    },
    {
      title: "[Marcador] Servidor de juego multijugador",
      tagline: "Borrador — falta la línea resumen.",
      problem:
        "Borrador — falta confirmar qué parte del problema de concurrencia server-authoritative se puede mostrar públicamente.",
      technologies: [".NET", "TCP", "SQL Server"],
      repoUrl: null,
      liveUrl: null,
    },
    {
      title: "[Marcador] Tercer proyecto — sin definir",
      tagline: "Borrador — falta la línea resumen.",
      problem: "Borrador — pendiente de selección en F1-C.",
      technologies: ["A definir"],
      repoUrl: null,
      liveUrl: null,
    },
  ],
};

const cards =
  realProjects.length > 0
    ? realProjects.map((p) => ({
        title: p.title[lang],
        tagline: p.description[lang],
        problem: null,
        technologies: p.technologies ?? [],
        repoUrl: p.repoUrl,
        liveUrl: p.liveUrl,
        isPlaceholder: false,
      }))
    : PLACEHOLDER_PROJECTS[lang].map((p) => ({ ...p, isPlaceholder: true }));
---

<section id="projects" class="section">
  <div class="container">
    <SectionHeading number="01" title={t.sections.projects} id="projects" />
    <div class="project-grid">
      {cards.map((card) => (
        <ProjectCard lang={lang} {...card} />
      ))}
    </div>
  </div>
</section>
