---
import { ui } from "../i18n/ui.js";

interface Props {
  lang: "en" | "es";
  // F-18 (ADR-0019 §1): ids semánticos de las secciones con contenido, en
  // el orden real en que HomePage.astro las va a renderizar (ya sin
  // "intro": el hero no lleva ancla propia en esta fila, igual que antes
  // "top" tampoco aparecía en el nav). HomePage ya filtró las que no
  // tienen contenido (about sin summary, education sin items) — este
  // componente no vuelve a decidir eso, sólo dibuja lo que le llega.
  sections: string[];
}
const { lang, sections } = Astro.props;
const t = ui[lang];
const homeHref = lang === "es" ? "/es/" : "/";
const isEn = lang === "en";
---

<!--
  Estructura en dos partes (F-11): `.site-nav__bar` (marca + toggle de tema +
  selector de idioma) y `.site-nav__anchors` (las anclas de sección). En
  mobile son dos elementos independientes -- sólo la barra queda `sticky`,
  las anclas se van con el scroll -- y en desktop `.site-nav` (el `<header>`)
  es el único elemento sticky, con `.site-nav__bar` colapsado vía
  `display: contents` para que sus hijos se acomoden como ítems directos de
  la misma fila que las anclas (ver global.css, sección "Nav"). Esto
  reemplaza el `<ul>` único que antes mezclaba anclas + toggle + selector de
  idioma en la misma lista.
-->
<header class="site-nav">
  <div class="site-nav__bar">
    <a class="site-nav__brand" href={homeHref}>Diego Chiquiar</a>
    <div class="site-nav__controls">
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-pressed="true"
        aria-label={t.theme.toggleLabel}
      >
        <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.742 13.045a8.088 8.088 0 0 1-2.077.273c-4.464 0-8.08-3.616-8.08-8.08 0-.72.096-1.42.273-2.077a.75.75 0 0 0-.988-.876A10.5 10.5 0 1 0 21.618 14.033a.75.75 0 0 0-.876-.988Z"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
      </button>
      <div class="lang-switch" role="group" aria-label={t.lang.groupLabel}>
        {isEn ? (
          <span class="lang-switch__current" aria-current="page">EN</span>
        ) : (
          <a class="lang-switch__link" href="/" hreflang="en">EN</a>
        )}
        <span class="lang-switch__sep" aria-hidden="true">/</span>
        {isEn ? (
          <a class="lang-switch__link" href="/es/" hreflang="es">ES</a>
        ) : (
          <span class="lang-switch__current" aria-current="page">ES</span>
        )}
      </div>
    </div>
  </div>
  <nav class="site-nav__anchors" aria-label={t.nav.sectionsLabel}>
    <ul class="site-nav__links">
      {sections.map((id) => (
        <li><a href={`#${id}`}>{t.nav[id]}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    var root = document.documentElement;

    // Mismos dos <meta name="theme-color"> de BaseLayout.astro (uno por
    // media). El toggle gana sobre la preferencia del sistema: en vez de
    // detectar cuál de los dos está "activo" según el sistema, se
    // sincronizan los dos al color del tema resuelto — así el que el
    // navegador use ya tiene el valor correcto sin importar el
    // prefers-color-scheme real del dispositivo. Colores calcados de
    // --color-bg en global.css (ver comentario en BaseLayout.astro).
    var metaLight = document.querySelector(
      'meta[name="theme-color"][media="(prefers-color-scheme: light)"]',
    );
    var metaDark = document.querySelector(
      'meta[name="theme-color"][media="(prefers-color-scheme: dark)"]',
    );

    function sync() {
      var dark = root.getAttribute("data-theme") !== "light";
      btn.setAttribute("aria-pressed", dark ? "true" : "false");
      var color = dark ? "#0f121f" : "#f6ecd3";
      if (metaLight) metaLight.setAttribute("content", color);
      if (metaDark) metaDark.setAttribute("content", color);
    }

    sync();

    btn.addEventListener("click", function () {
      var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {
        // Ventana privada o storage bloqueado: el tema igual se aplica
        // para esta carga, sólo no persiste entre recargas.
      }
      sync();
    });
  })();
</script>
