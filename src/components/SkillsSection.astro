---
// F-18 (ADR-0019 §3): la órbita abre la sección, centrada y más grande —
// ya no comparte fila con el título (ver StackOrbit.astro/global.css para
// el tamaño). Debajo, la intro corta y las tarjetas de categorías, sin
// cambios de contenido.
import { ui } from "../i18n/ui.js";
import SectionHeading from "./SectionHeading.astro";
import StackOrbit from "./StackOrbit.astro";
import { cleanField, cleanList } from "../lib/content.js";

interface Props {
  lang: "en" | "es";
  number: string;
  categories: Array<{ id: string; label: string; items: string[] }>;
  languages: Array<{ name: string; level: string; note: string | null }>;
  intro?: string | null;
  // Forma vigente de "En formación" (skills.learning, objeto). Opcional:
  // cv.en.yaml todavía no lo trae (sólo cv.es.yaml, F-18) — sin este prop,
  // se recurre a la categoría legacy con id "learning" (ver más abajo).
  learning?: { label: string; description?: string | null; items: string[] } | null;
}
const { lang, number, categories, languages, intro = null, learning = null } = Astro.props;
const t = ui[lang];

// Filtra items marcados como TODO/pendiente de confirmación y descarta
// categorías que queden vacías (no se muestra una categoría sin contenido).
const cleanedCategories = categories
  .map((cat) => ({ ...cat, items: cleanList(cat.items) }))
  .filter((cat) => cat.items.length > 0);

// "En formación" (F-18): la forma vigente es `skills.learning`, un objeto
// aparte de `categories` (cv.es.yaml). Mientras cv.en.yaml no se
// sincronice, sigue trayendo la forma vieja: una categoría más dentro de
// `categories` con id "learning" (ver data/schemas/cv.schema.json). Nunca
// se usan las dos a la vez para el mismo idioma, pero el código igual
// separa la categoría legacy del resto de la grilla por si acaso, para no
// duplicar la tarjeta.
const legacyLearningCategory = cleanedCategories.find((cat) => cat.id === "learning") ?? null;
const displayCategories = cleanedCategories.filter((cat) => cat.id !== "learning");

const learningSource = learning
  ? {
      label: cleanField(learning.label),
      description: cleanField(learning.description ?? null),
      items: cleanList(learning.items),
    }
  : legacyLearningCategory
    ? { label: legacyLearningCategory.label, description: null, items: legacyLearningCategory.items }
    : null;

const learningBlock =
  learningSource && learningSource.label && learningSource.items.length > 0 ? learningSource : null;
---

<section id="skills" class="section">
  <div class="container">
    <SectionHeading number={number} title={t.sections.skills} id="skills" />

    {/* F-26 (ADR-0026): la órbita entra como bloque propio, antes que las
       tarjetas — su animación de rotación sigue igual (no se toca), esto
       sólo agrega la aparición del CONTENEDOR. */}
    <div class="stack__orbit-wrap" data-reveal>
      <StackOrbit />
    </div>

    {/* F-20 (A-4 P2-2): se deja de renderizar skills.intro — la oración
       entre la órbita y las tarjetas no agregaba información que el
       título de sección y la propia órbita no dijeran ya, sólo ocupaba
       una línea. El campo (y el prop `intro`) se mantienen intactos: es
       contenido de Diego en el YAML, esto sólo deja de mostrarlo. */}

    {/* F-26: cada tarjeta revela en orden de lectura (Backend, Data,
       Desktop/Mobile, Tools…), escalonada por `--reveal-index` — el CSS
       la topa a 240ms totales (ver "Reveals al scroll" en global.css), así
       que no importa si algún día hay más de 4 categorías. Las etiquetas
       de adentro (`.tag`) NO llevan `data-reveal`: la tarjeta entera es la
       unidad, pedido explícito del brief ("no animes cada etiqueta"). */}
    <div class="stack-grid">
      {displayCategories.map((cat, i) => (
        <div class="stack-card" data-reveal style={`--reveal-index: ${i}`}>
          <div class="stack-card__header">
            <h3 class="stack-card__title">{cat.label}</h3>
            <span class="stack-card__num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>
          <ul class="tag-list">
            {cat.items.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </div>
      ))}
      {learningBlock && (
        // "Currently"/"En formación" es su propio bloque (brief), no un
        // ítem más del escalonado de arriba — por eso no sigue la
        // secuencia de `i`, tiene su propio índice después de todas.
        <div
          class="stack-card stack-card--learning"
          data-reveal
          style={`--reveal-index: ${displayCategories.length}`}
        >
          <div class="stack-card__header">
            <h3 class="stack-card__title">{learningBlock.label}</h3>
            <span class="stack-card__num" aria-hidden="true">
              {String(displayCategories.length + 1).padStart(2, "0")}
            </span>
          </div>
          {learningBlock.description && <p class="stack-card__desc">{learningBlock.description}</p>}
          <ul class="tag-list">
            {learningBlock.items.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {languages.length > 0 && (
      // Bloque propio (brief: "idiomas como bloque propio"), sin
      // escalonar cada idioma por separado.
      <div class="stack__languages" data-reveal>
        <h3>{t.skills.languages}</h3>
        <ul class="languages-list">
          {languages.map((l) => (
            <li>
              <strong>{l.name}</strong>
              <span>{l.level}</span>
              {l.note && <p class="note">{l.note}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
