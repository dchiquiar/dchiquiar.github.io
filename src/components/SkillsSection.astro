---
import { ui } from "../i18n/ui.js";
import SectionHeading from "./SectionHeading.astro";
import { cleanList } from "../lib/content.js";

interface Props {
  lang: "en" | "es";
  categories: Array<{ id: string; label: string; items: string[] }>;
  languages: Array<{ name: string; level: string; note: string | null }>;
  intro?: string | null;
}
const { lang, categories, languages, intro = null } = Astro.props;
const t = ui[lang];

// Filtra items marcados como TODO/pendiente de confirmación y descarta
// categorías que queden vacías (no se muestra una categoría sin contenido).
const cleanCategories = categories
  .map((cat) => ({ ...cat, items: cleanList(cat.items) }))
  .filter((cat) => cat.items.length > 0);
---

<section id="stack" class="section">
  <div class="container">
    <div class="stack__intro">
      <SectionHeading number="03" title={t.sections.stack} id="stack" />
      {intro && <p class="stack__lead">{intro}</p>}
    </div>

    <div class="stack-grid">
      {cleanCategories.map((cat, i) => (
        <div class={`stack-card${cat.id === "learning" ? " stack-card--learning" : ""}`}>
          <div class="stack-card__header">
            <h3 class="stack-card__title">{cat.label}</h3>
            <span class="stack-card__num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>
          <ul class="tag-list">
            {cat.items.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {languages.length > 0 && (
      <div class="stack__languages">
        <h3>{t.skills.languages}</h3>
        <ul class="languages-list">
          {languages.map((l) => (
            <li>
              <strong>{l.name}</strong>
              <span>{l.level}</span>
              {l.note && <p class="note">{l.note}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
