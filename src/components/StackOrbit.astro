// Fase inicial por anillo: sólo estética (evita que los 12 ítems arranquen
// alineados en radios). No codifica nada — ADR-0018. El paso entre ítems
// de un mismo anillo es 360°/3 (cada anillo tiene 3 tecnologías, F-13b).
const startAngles = [0, 45, 90, 135];
---

<div class="stack-orbit" aria-hidden="true">
  <div class="orbit-stage">
    <div class="orbit-center"><span>STACK</span></div>
    {
      rings.map((ring, ringIndex) => (
        <div class={`orbit-ring orbit-ring--${ringIndex + 1}`}>
          {ring.map((tech, i) => (
            <div
              class="orbit-pos"
              style={`--angle: ${startAngles[ringIndex] + i * (360 / ring.length)}deg`}
            >
              <div class="orbit-item">
                <svg viewBox="0 0 24 24">
                  <path d={tech.path} />
                </svg>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>
