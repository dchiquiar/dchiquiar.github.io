---
// Subrayado "a mano" bajo una palabra: un trazo SVG que se dibuja al
// revelarse (stroke-dashoffset, ver .scribble en site.css).
interface Props { variant?: 1 | 2 }
const { variant = 1 } = Astro.props;
const d =
  variant === 1
    ? "M2 14 C 40 8, 90 6, 150 9 S 250 15, 298 8"
    : "M3 10 C 60 15, 120 5, 180 9 S 260 13, 297 6";
---
<svg class="scribble" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true">
  <path d={d} pathLength="1" />
</svg>
