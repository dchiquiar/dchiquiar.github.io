---
// Layout único para las dos páginas (en/es). Todo lo que cambia entre
// idiomas llega por props; el markup no se duplica.
import { ui } from "../i18n/ui.js";
import TopBar from "../components/TopBar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/site.css";

interface Props {
  lang: "en" | "es";
  title: string;
  description: string;
  jsonLd: Record<string, unknown>;
  sections: string[];
}

const { lang, title, description, jsonLd, sections } = Astro.props;
const t = ui[lang];

const path = lang === "es" ? "/es/" : "/";
const canonicalUrl = new URL(path, Astro.site);
const enUrl = new URL("/", Astro.site);
const esUrl = new URL("/es/", Astro.site);
const ogImageFile = lang === "es" ? "/og-image-es.png" : "/og-image.png";
const ogImageUrl = new URL(ogImageFile, Astro.site);
const ogImageAlt = title;
const ogLocale = lang === "es" ? "es_UY" : "en_US";
const ogLocaleAlt = lang === "es" ? "en_US" : "es_UY";
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-variable.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-mono-variable.woff2" crossorigin />
    <script is:inline>
      // Tema, tinta y movimiento antes del primer pintado (sin flash).
      // localStorage puede lanzar en ventana privada: todo en try/catch.
      (function () {
        var d = document.documentElement;
        try {
          var theme = localStorage.getItem("theme");
          if (theme !== "light" && theme !== "dark") {
            theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          }
          d.setAttribute("data-theme", theme);
          var ink = localStorage.getItem("ink");
          if (ink) d.setAttribute("data-ink", ink);
          var motion = localStorage.getItem("motion");
          if (motion === "off") d.setAttribute("data-motion", "off");
          if (localStorage.getItem("trail") === "off") d.setAttribute("data-trail", "off");
        } catch (e) {}
        var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce && !d.hasAttribute("data-motion")) d.setAttribute("data-motion", "off");
        if ("IntersectionObserver" in window) d.classList.add("js");
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12100e" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <TopBar lang={lang} sections={sections} />
    <slot />
    <SiteFooter lang={lang} />
    <canvas class="pen-trail" aria-hidden="true"></canvas>
    <script is:inline>
      // Preferencias (componente Prefs, en portada y pie): todas las copias
      // se sincronizan entre sí y la elección se guarda por visitante.
      (function () {
        var d = document.documentElement;
        function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
        function sync() {
          var current = d.getAttribute("data-ink") || "ember";
          document.querySelectorAll(".swatch").forEach(function (s) {
            s.setAttribute("aria-checked", String(s.getAttribute("data-ink") === current));
          });
          document.querySelectorAll("[data-ink-name]").forEach(function (el) {
            var on = document.querySelector('.swatch[data-ink="' + current + '"]');
            el.textContent = on ? on.getAttribute("title") : "";
          });
          document.querySelectorAll("[data-pref-toggle]").forEach(function (b) {
            var key = b.getAttribute("data-pref-toggle");
            var on = d.getAttribute("data-" + key) !== "off";
            var label = b.querySelector("[data-on]");
            b.setAttribute("aria-pressed", String(on));
            label.textContent = on ? label.getAttribute("data-on") : label.getAttribute("data-off");
          });
        }
        document.querySelectorAll(".swatch").forEach(function (s) {
          s.addEventListener("click", function () {
            var id = s.getAttribute("data-ink");
            d.setAttribute("data-ink", id);
            save("ink", id);
            sync();
          });
        });
        document.querySelectorAll("[data-pref-toggle]").forEach(function (b) {
          b.addEventListener("click", function () {
            var key = b.getAttribute("data-pref-toggle");
            var turnOff = d.getAttribute("data-" + key) !== "off";
            if (turnOff) d.setAttribute("data-" + key, "off"); else d.removeAttribute("data-" + key);
            save(key, turnOff ? "off" : "on");
            sync();
          });
        });
        sync();
      })();
    </script>
    <script is:inline>
      // Trazo de tinta que sigue al mouse con retardo: un punto "pluma" se
      // acerca al cursor con easing y deja una estela fina que se desvanece.
      // Sólo con mouse fino y con movimiento activo.
      (function () {
        var canvas = document.querySelector(".pen-trail");
        if (!canvas || !canvas.getContext) return;
        var fine = window.matchMedia && window.matchMedia("(pointer: fine)").matches;
        if (!fine) return;
        var d = document.documentElement;
        var ctx = canvas.getContext("2d");
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var mouse = null, pen = null, pts = [], running = false;
        var MAX = 28, EASE = 0.16;
        function resize() {
          canvas.width = innerWidth * dpr;
          canvas.height = innerHeight * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resize();
        addEventListener("resize", resize);
        function ink() {
          return getComputedStyle(d).getPropertyValue("--ink").trim() || "#f2743b";
        }
        var color = ink();
        new MutationObserver(function () { color = ink(); }).observe(d, { attributes: true, attributeFilter: ["data-ink", "data-theme"] });
        function frame() {
          ctx.clearRect(0, 0, innerWidth, innerHeight);
          if (d.getAttribute("data-motion") === "off" || d.getAttribute("data-trail") === "off" || !mouse) { running = false; pts = []; return; }
          pen.x += (mouse.x - pen.x) * EASE;
          pen.y += (mouse.y - pen.y) * EASE;
          pts.push({ x: pen.x, y: pen.y });
          if (pts.length > MAX) pts.shift();
          ctx.lineCap = "round";
          ctx.lineJoin = "round";
          ctx.strokeStyle = color;
          for (var i = 1; i < pts.length; i++) {
            var t = i / pts.length;
            ctx.globalAlpha = t * 0.85;
            ctx.lineWidth = 0.4 + t * 1.2;
            ctx.beginPath();
            ctx.moveTo(pts[i - 1].x, pts[i - 1].y);
            ctx.lineTo(pts[i].x, pts[i].y);
            ctx.stroke();
          }
          ctx.globalAlpha = 1;
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc(pen.x, pen.y, 2.2, 0, Math.PI * 2);
          ctx.fill();
          var still = Math.abs(mouse.x - pen.x) + Math.abs(mouse.y - pen.y) < 0.3 &&
            pts.length && Math.abs(pts[0].x - pen.x) + Math.abs(pts[0].y - pen.y) < 0.3;
          if (still) { running = false; return; }
          requestAnimationFrame(frame);
        }
        addEventListener("mousemove", function (e) {
          mouse = { x: e.clientX, y: e.clientY };
          if (!pen) pen = { x: mouse.x, y: mouse.y };
          if (!running) { running = true; requestAnimationFrame(frame); }
        }, { passive: true });
        document.addEventListener("mouseleave", function () {
          mouse = null; pen = null;
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        // Reveals: un solo IntersectionObserver para [data-reveal]. Sin JS
        // (o sin IO) la clase .js nunca se agrega y todo es visible.
        if (d.classList.contains("js")) {
          var reveal = function (el) { el.classList.add("is-in"); };
          try {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); }
              });
            }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
            document.querySelectorAll("[data-reveal]").forEach(function (el) { io.observe(el); });
            document.addEventListener("focusin", function (e) {
              var el = e.target.closest && e.target.closest("[data-reveal]");
              if (el) reveal(el);
            });
            setTimeout(function () {
              document.querySelectorAll("[data-reveal]").forEach(reveal);
            }, 5000);
          } catch (err) {
            d.classList.remove("js");
          }
        }

        // Riel de cada capítulo: la tinta baja a medida que se scrollea.
        var chapters = Array.prototype.slice.call(document.querySelectorAll("[data-chapter]"));
        var ticking = false;
        function paint() {
          var vh = window.innerHeight;
          chapters.forEach(function (c) {
            var r = c.getBoundingClientRect();
            var p = (vh * 0.6 - r.top) / Math.max(r.height, 1);
            c.style.setProperty("--progress", Math.max(0, Math.min(1, p)).toFixed(3));
          });
          ticking = false;
        }
        window.addEventListener("scroll", function () {
          if (!ticking) { ticking = true; requestAnimationFrame(paint); }
        }, { passive: true });
        paint();

        // Sección activa en la barra superior.
        var links = document.querySelectorAll("[data-nav-link]");
        if (links.length && "IntersectionObserver" in window) {
          var navIo = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              links.forEach(function (l) {
                l.toggleAttribute("aria-current", l.getAttribute("href") === "#" + e.target.id);
              });
            });
          }, { rootMargin: "-45% 0px -50% 0px" });
          chapters.forEach(function (c) { navIo.observe(c); });
        }
      })();
    </script>
  </body>
</html>
